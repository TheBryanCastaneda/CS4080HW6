class Circle {
  init(radius) {
    this.radius = radius;
  }

  area {
    return 3.141592653 * this.radius * this.radius;
  }
}

var circle = Circle(4);
print circle.area;

circle.radius = 2;
print circle.area;

class Scale {
  class doubled {
    return this.factor * 2;
  }
}

Scale.factor = 5;
print Scale.doubled;

circle.area = 99;
print circle.area;